# 배포 환경별 설정값. docker-compose.deploy.yml 이 이 값들을 읽는다.
# 실행:
#   docker compose --env-file toolkit.env -f docker-compose.deploy.yml up -d
#
# 이 파일은 PC마다 경로가 다르므로 git에 안 올리는 걸 권장 (.gitignore 처리).

# ── 디스크 경로 ────────────────────────────────────────────────
# [HDD] 영구 저장소. 읽기·쓰기. 원본 데이터셋·모델·학습결과가 여기 쌓인다.
#   윈도우 예:  E:/yolo-data
#   WSL2/리눅스 예:  /mnt/hdd/yolo-data
HDD_DIR=./data

# [SSD] 학습용 임시 캐시. 런 시작 시 HDD의 데이터셋을 여기로 복제해 읽고, 끝나면 삭제한다.
#   윈도우 예:  D:/yolo-ssd-cache
#   WSL2/리눅스 예:  /mnt/ssd/yolo-cache
SSD_CACHE_DIR=./ssd-cache

# ── 실행 옵션 ──────────────────────────────────────────────────
# 사용할 디바이스:  0 (cuda 0번) | cpu
YVT_DEVICE=0

# DataLoader 공유메모리. RAM 32GB↑=8gb, 16GB=4gb 권장
SHM_SIZE=8gb

# 프론트엔드 접속 포트 (호스트)
FRONTEND_PORT=3000

# 사용할 이미지 태그:  latest | v1.0 등
IMAGE_TAG=latest
