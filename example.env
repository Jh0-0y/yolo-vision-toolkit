# 배포 설정 템플릿. 최초 1회 복사해서 값만 환경에 맞게 고치세요:
#   cp example.env .env
# docker compose 가 같은 폴더의 .env 를 자동으로 읽습니다.
# (이 example.env 는 git 에 커밋, 실제 값이 든 .env 는 .gitignore 처리됨)

# ── 디스크 경로 ──────────────────────────────────────────────
# [HDD] 영구 저장소. 읽기·쓰기. 원본 데이터셋·모델·학습결과·DB 가 여기 쌓인다.
#   윈도우 예:  E:/yolo-data      /   WSL2·리눅스 예:  /mnt/hdd/yolo-data
DATA_DIR=./data

# [SSD] 학습용 임시 캐시. 런 시작 시 데이터셋을 여기로 복제해 읽고, 끝나면 삭제한다.
#   윈도우 예:  D:/yolo-cache     /   WSL2·리눅스 예:  /mnt/ssd/yolo-cache
# 스테이징이 불필요하면 DATA_DIR 과 같은 경로로 두세요(같은 저장소로 감지해 복사 건너뜀).
CACHE_DIR=./cache

# ── 실행 옵션 ────────────────────────────────────────────────
# 사용할 디바이스:  0 (cuda 0번) | cpu
YVT_DEVICE=0

# DataLoader 공유메모리. RAM 32GB↑=8gb, 16GB=4gb 권장
SHM_SIZE=8gb

# 프론트엔드 접속 포트 (호스트)
FRONTEND_PORT=3000

# 사용할 이미지 태그:  latest | v1.0 등. 빌드/푸시(scripts/build.sh)와 실행이 같은 값을 씀.
TAG=latest
