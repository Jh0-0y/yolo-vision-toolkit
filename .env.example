# 이 파일을 `.env` 로 복사한 뒤 경로만 환경에 맞게 고치면 됩니다.
#   cp .env.example .env
# docker compose 가 아래 값을 읽어 컨테이너에 마운트합니다.
# (이미지는 그대로, 여기 경로만 바꾸면 됨.)

# 벌크 저장소(HDD): 데이터셋·모델·학습결과·DB 가 영구 저장되는 곳.
#   Linux 예:   DATA_DIR=/mnt/hdd/yvt-data
#   Windows 예: DATA_DIR=D:/yolo/data
DATA_DIR=./data

# 빠른 임시 저장소(SSD): 학습 직전 해당 데이터셋을 여기로 복사해서 학습하고,
# 학습이 끝나면(성공/실패/취소 무관) 자동으로 삭제합니다. 반드시 쓰기 가능.
#   Linux 예:   CACHE_DIR=/mnt/ssd/yvt-cache
#   Windows 예: CACHE_DIR=C:/cache/yvt
# 스테이징이 필요 없으면 DATA_DIR 과 같은 경로로 두세요("이미 같은 저장소"로 감지해 복사 건너뜀).
CACHE_DIR=./cache

# 추론/학습 디바이스: auto | cpu | mps | 0 (cuda index)
YVT_DEVICE=auto

# GHCR 이미지 버전 태그. 빌드/푸시/풀 모두 이 값을 씀.
#   맥(빌드):   TAG=v1.2.3 docker compose build && TAG=v1.2.3 docker compose push
#   서버(실행): 여기에 실행할 버전을 적고 docker compose pull && up
# 미지정 시 latest.
TAG=latest
